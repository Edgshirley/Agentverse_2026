# Copy to secrets.env (git-ignored) and fill in. NEVER commit real keys.
# Read by the rules engine (backend) for the AI agents — see INSTRUCTIONS.md.
#   cp secrets.env.example secrets.env

# Google Gemini (preferred). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible fallback for strategy parsing only. Bets, briefings and results need Gemini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
