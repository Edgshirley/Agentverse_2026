{
  "name": "friend-spreader-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MarketMate — Deterministic Rules Engine, AI Pipeline & Hono API Server",
  "scripts": {
    "dev": "npm run build && DEV_TOOLS=1 node scripts/run_server.mjs",
    "build": "tsc --noEmit && esbuild src/worker/index.ts --bundle --platform=node --format=esm --outfile=dist/worker.mjs && esbuild src/worker/sqlite_d1.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=dist/sqlite_d1.mjs",
    "start": "node scripts/run_server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "hono": "^4.7.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
