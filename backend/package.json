{
  "name": "marketmate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MarketMate — Deterministic Rules Engine, internal Hono service behind the FastAPI gateway",
  "scripts": {
    "dev": "npm run build && DEV_TOOLS=1 node scripts/run_server.mjs",
    "build": "tsc --noEmit && esbuild src/worker/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/worker.mjs && esbuild src/worker/sqlite_d1.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/sqlite_d1.mjs",
    "start": "node scripts/run_server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "pg": "^8.13.3",
    "redis": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
