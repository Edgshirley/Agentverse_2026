ENV="dev"
VERSION="1.0.0"
TITLE="MarketMate API"

# =================== <BACKEND CONFIGURATION> =================== #
# The UI (vite :5173) proxies /api (HTTP + WebSocket) to the FastAPI api, so
# the browser only ever talks to :5173 and Keycloak on :8080.
FRONTEND_EXT_URL="http://localhost:5173"
KEYCLOAK_EXT_URL="http://localhost:8080"
KEYCLOAK_REDIRECT_URI="http://localhost:5173/api/v1/system/callback"
POST_LOGOUT_REDIRECT_URI="http://localhost:5173"

FRONTEND_COOKIE_SAMESITE="lax"
FRONTEND_COOKIE_SECURE="false"

# kc-config writes the backend client secret here; the api reads it.
CLIENT_SECRET_SHARED_DIRECTORY="./spread-storage/shared"
# =============================================================== #

# ====================== <DATABASE CONFIG> ====================== #
# Superuser (bootstrap only)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_HOST="postgres"

# Application role + database (api, db-migrate, engine)
SPREAD_USER="spread"
SPREAD_PASSWORD="spread_password"
SPREAD_DB="spread"

# Keycloak role + database
KC_DB="postgres"
KC_DB_USERNAME="keycloak"
KC_DB_PASSWORD="keycloak_password"
KC_DB_URL="jdbc:postgresql://postgres:5432/keycloak"
# =============================================================== #

# ====================== <KEYCLOAK CONFIG> ====================== #
KC_BOOTSTRAP_ADMIN_USERNAME="temp-admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="admin"
KEYCLOAK_REALM="master"

# Permanent admin created by kc-config (Keycloak console: http://localhost:8080)
KC_ADMIN_EMAIL="admin@spread.local"
KC_ADMIN_USERNAME="admin"
KC_ADMIN_PASSWORD="admin"

# Password of the seeded ring traders alice / bob / carol / dave
SEED_USERS_PASSWORD="spread123"

KEYCLOAK_URL="http://keycloak:8080"
KEYCLOAK_BACKEND_CLIENT_ID="spread-api"
KEYCLOAK_FRONTEND_CLIENT_ID="spread-ui"
KC_HOSTNAME="localhost"
KC_HEALTH_ENABLED=true
KC_HTTP_ENABLED=true
# =============================================================== #

# ==================== <REDIS CONFIGURATION> ==================== #
REDIS_HOST="redis"
# Keep >= the realm's remember-me SSO max lifespan (30 days).
SESSION_TTL_SECONDS="2592000"
# =============================================================== #

# ================== <MESSAGE BUS CONFIGURATION> ================ #
MESSAGE_BUS="redis"
BUS_CHANNEL="spread-messages"
# =============================================================== #
