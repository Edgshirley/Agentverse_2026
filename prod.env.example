# Copy to prod.env (git-ignored) and fill in. Used by `make prod`.
VERSION="1.0.0"
TITLE="MarketMate API"

# Public URLs (nginx terminates TLS and forwards to the loopback ports)
#   https://marketmate.example.com -> 127.0.0.1:3900   (UI, also serves /api)
#   https://auth.example.com   -> 127.0.0.1:8980   (Keycloak)
#   127.0.0.1:8900 is the FastAPI backend itself (optional direct access)
FRONTEND_EXT_URL="https://marketmate.example.com"
FRONTEND_ALLOWED_HOSTS="marketmate.example.com"
FRONTEND_COOKIE_SECURE="true"
FRONTEND_COOKIE_SAMESITE="lax"
KEYCLOAK_REDIRECT_URI="https://marketmate.example.com/api/v1/system/callback"
POST_LOGOUT_REDIRECT_URI="https://marketmate.example.com"

# Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
SPREAD_USER="spread"
SPREAD_PASSWORD="change-me"
SPREAD_DB="spread"
KC_DB_USERNAME="keycloak"
KC_DB_PASSWORD="change-me"

# Keycloak
KC_HOSTNAME="https://auth.example.com"
KEYCLOAK_EXT_URL="https://auth.example.com"
KEYCLOAK_REALM="master"
KC_BOOTSTRAP_ADMIN_USERNAME="temp-admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="change-me"
KEYCLOAK_FRONTEND_CLIENT_ID="spread-ui"
KEYCLOAK_BACKEND_CLIENT_ID="spread-api"
# Secret of the confidential `spread-api` client (Clients -> spread-api -> Credentials)
KEYCLOAK_CLIENT_SECRET=""

# Redis
REDIS_PASSWORD="change-me"
SESSION_TTL_SECONDS="2592000"
BUS_CHANNEL="spread-messages"

# Powers the bot and the outside-odds panel (host only, never commit a real key)
# Gemini API key (Google AI Studio). Reviews every new bet and powers the
# engine's draft / outside-odds agents.
GEMINI_API=""
# Model reviewing new bets (cheaper Lite tier: gemini-3.5-flash-lite)
GEMINI_BET_MODEL="gemini-3.8-flash"
# Model of the engine's draft / outside-odds agents
GEMINI_MODEL="gemini-2.5-flash"
